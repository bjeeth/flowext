{
  "name": "flow-bulk-downloader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/verify-build.mjs",
    "test": "vitest run",
    "test:browser": "node scripts/browser-smoke.mjs",
    "inspect:evidence": "node scripts/review-evidence.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "0.1.24",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "26.1.0",
    "playwright-core": "1.64.0",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
