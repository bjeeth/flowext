{
  "manifest_version": 3,
  "name": "Flow Bulk Downloader",
  "version": "0.6.0",
  "minimum_chrome_version": "116",
  "description": "Export selected or all Flow images with direct upscaling and tracked browser downloads.",
  "optional_permissions": [
    "downloads"
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flow Bulk Downloader"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
